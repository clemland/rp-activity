  .skill .up{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center;text-align:left}
  .shop-top{grid-template-columns:1fr}
  .composer{grid-template-columns:1fr}
  .sea-log{height:300px}
}

