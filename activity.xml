.craft-gives{display:flex;flex-direction:column;gap:6px}
.craft-acts{display:flex;flex-direction:column;gap:6px;align-items:stretch}
.recipes{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
