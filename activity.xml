.recipe.locked{opacity:.75}
.gest-search{max-width:280px}
.gest-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;margin-top:12px}
.gest-card{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;text-align:left;border:2px solid var(--ink);border-radius:8px;background:#fbf0d2;padding:8px 10px;cursor:pointer;font:inherit;color:inherit;transition:transform .12s}
.gest-card:hover{transform:translateY(-2px);background:#fff6dc}
.gest-card .slot-ico{width:52px;height:52px}
.gest-card .slot-ico .ico{--s:40px}
