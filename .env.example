# ─── À mettre dans Vercel > Settings > Environment Variables (et dans .env pour tester en local) ───

# Developer Portal > General Information
VITE_DISCORD_CLIENT_ID=
# Developer Portal > OAuth2 > Client Secret (ne jamais le partager)
DISCORD_CLIENT_SECRET=
# Developer Portal > Bot > Token (sert à vérifier les rôles staff et les noms de salons)
DISCORD_BOT_TOKEN=

# Serveur principal : les droits staff y sont vérifiés
GUILD_ID=
# Propriétaires (accès staff partout), séparés par des virgules
OWNER_IDS=
# Rôles staff du serveur principal, séparés par des virgules (les admins le sont déjà)
STAFF_ROLE_IDS=

# Secret partagé avec le bot (même valeur que BOT_API_SECRET dans le .env du bot)
# Génère une longue chaîne au hasard, par exemple avec : node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BOT_API_SECRET=

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
