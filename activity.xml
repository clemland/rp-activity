.it-preview .ico{--s:56px}
.rc-row{display:grid;grid-template-columns:34px minmax(0,1fr) 90px 32px;gap:8px;align-items:center}
.rc-row select,.rc-row input{width:100%;min-width:0;font:inherit;font-size:15px;color:var(--brown);background:#fffaea;border:2px solid var(--ink);border-radius:5px;padding:4px 6px}
.rc-time{display:grid;grid-template-columns:1fr 1.2fr;gap:6px}
.nav-soon{text-align:center;padding:40px 20px}
@media (max-width:620px){.craft-now{grid-template-columns:1fr}.recipes,.gest-grid{grid-template-columns:1fr}}
.voyage:has(.nav-soon){display:block;max-width:720px;margin:0 auto}

