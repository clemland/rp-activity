/* ═══ v12 : édition complète ═════════════════════════ */
.ed-h{font-family:"Ultra",Georgia,serif;font-weight:400;font-size:18px;margin:22px 0 8px;padding-top:14px;border-top:2px dotted rgba(61,38,20,.35)}
.pick-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:6px 0}
.pick-l{display:inline-flex;align-items:center;gap:8px;font-weight:800}
.pick-l .ico{--s:28px}
.pick{display:flex;align-items:center;gap:2px}
.pick button{background:none;border:none;padding:2px;cursor:pointer;border-radius:4px;line-height:0}
.pick button .ico{--s:26px}
.pick button:hover{background:rgba(230,162,35,.25)}
.pick .pick-zero{min-width:96px;text-align:center;line-height:1.2;font-size:12px;font-weight:800;color:var(--muted);border:1.5px solid rgba(61,38,20,.4);padding:3px 8px;margin-left:6px}
.pick .pick-zero[aria-checked="true"]{background:var(--ink);color:#fff3cf;border-color:var(--ink)}
.pick button.bump{animation:pop .25s ease-out}


/* ═══ v13 : auvent aligné sur l'étal ═════════════════ */
.stall{padding-top:0}
.awning{position:relative;top:auto;left:auto;right:auto;height:52px;z-index:2;border:3px solid var(--ink);border-radius:10px 10px 0 0;
  background:linear-gradient(90deg,var(--red) 50%,#fff3e0 50%) 0 0/92px 100% round;box-shadow:7px 7px 0 var(--shadow)}
.awning::after{left:0;right:0;top:100%;height:24px;
  background:radial-gradient(circle at 25% 0,var(--red) 21px,var(--ink) 21px 24px,transparent 24px),
             radial-gradient(circle at 75% 0,#fff3e0 21px,var(--ink) 21px 24px,transparent 24px);
  background-size:92px 24px;background-repeat:round;background-position:0 0}
.stall-body{margin-top:-3px;border-top:3px solid var(--ink);border-radius:0 0 10px 10px;padding-top:44px}


/* ═══ v14 : vente au curseur ═════════════════════════ */
.wares .ware.sell .sellbox{grid-column:1/-1;display:grid;gap:6px;border-top:2px dashed rgba(61,38,20,.3);padding-top:8px}
.sellbox .ref{font-size:14px;color:var(--muted)}
.sellbox .ref b{font-family:"Ultra",Georgia,serif;font-weight:400;color:var(--brown)}
.ask-range{width:100%;accent-color:var(--gold)}
.ask-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.chance{font-size:13px;font-weight:800}
.chance.mid{color:#a8690c}
.sellbox .req{margin:0;font-size:13px}


/* ═══ v15 : auvent qui déborde, vente par glisser ════ */
.awning{margin:0 -10px;border-radius:10px 10px 4px 4px;box-shadow:0 3px 0 rgba(0,0,0,.12)}
.stall-body{padding-top:34px}
.sell-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:24px;align-items:start}
.sg-h{font-family:"Ultra",Georgia,serif;font-weight:400;font-size:18px;margin:0 0 8px}
.shold{grid-template-columns:repeat(6,1fr);gap:6px;padding:8px}
.shold .cell .ico{--s:clamp(26px,3.2vw,44px)}
.cell.nosell{opacity:.45}
.cell.on-counter{outline:3px solid var(--gold);outline-offset:-2px}
.counter-drop{min-height:300px;border:3px dashed rgba(23,37,94,.45);border-radius:10px;background:rgba(255,248,226,.6);display:grid;padding:16px;transition:background-color .15s,border-color .15s}
.counter-drop.filled{border-style:solid;border-color:var(--ink);background:#fbf0d2;box-shadow:4px 4px 0 rgba(23,37,94,.3)}
.counter-drop.over{border-color:var(--gold);background:#fff3c4}
.drop-hint{place-self:center;display:grid;justify-items:center;gap:4px;text-align:center;color:var(--muted)}
.drop-hint .ico{--s:48px;opacity:.8}
.drop-hint b{color:var(--brown);font-size:17px}
.offer{display:grid;gap:10px;align-content:start}
.offer-head{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center}
.offer-head h3{margin:0;font-size:19px}
.offer-head p{margin:0}
.offer .ref{font-size:14px;color:var(--muted)}
.offer .ref b{font-family:"Ultra",Georgia,serif;font-weight:400;color:var(--brown)}
.offer .price{font-size:24px}
.offer .btn{justify-self:stretch;justify-content:center}
.sm-close{width:32px;height:32px;font-size:17px}
@media (max-width:760px){.sell-grid{grid-template-columns:1fr}.counter-drop{min-height:200px}}


/* ═══ v16 : auvent en SVG ════════════════════════════ */
.awning{background:none!important;border:none!important;height:auto!important;box-shadow:none!important;line-height:0;margin:0 -10px -24px;position:relative;z-index:2}
.awning::after{display:none!important}
.awning svg{display:block}
.stall-body{margin-top:0;padding-top:40px;border-top:none;border-radius:0 0 10px 10px}


/* ═══ v17 : salon fixé par Discord ═══════════════════ */
.counter .face{border-radius:4px;width:64px;height:82px;font-size:40px}
.equip{grid-template-columns:repeat(2,1fr)}
.sheet{border-radius:10px}
.chan-tag{display:inline-flex;align-items:center;font-weight:800;font-size:15px;color:#3b4aa0;background:#e8ecfb;border:2px solid #3b4aa0;border-radius:4px;padding:3px 10px}
.shop-bar{align-items:center}


/* ═══ v18 : éditeur de boutique ══════════════════════ */
.counter .face{overflow:hidden;padding:0}
.counter .face img{width:100%;height:100%;object-fit:cover;display:block}
.counter p{font-style:normal;font-weight:700}
.se-face{display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:center;margin-top:16px}
.se-face .face{width:64px;height:82px;border:3px solid var(--ink);border-radius:4px;background:#fbf0d2;display:grid;place-items:center;font-size:40px;overflow:hidden;box-shadow:3px 3px 0 var(--shadow)}
.se-face .face img{width:100%;height:100%;object-fit:cover}
.se-face-ctl{display:grid;gap:8px}
.se-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.se-row input{font:inherit;color:var(--brown);background:#fffaea;border:3px solid var(--ink);border-radius:5px;padding:4px 8px}
.se-items{display:grid;gap:6px;margin-bottom:10px}
.se-head,.se-item{display:grid;grid-template-columns:34px minmax(0,1fr) 110px 120px 32px;gap:8px;align-items:center}
.se-head{font-size:12px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
.se-head span:first-child{grid-column:1/3}
.se-ico .ico{--s:32px}
.se-item select,.se-item input[type=number]{width:100%;min-width:0;font:inherit;font-size:15px;color:var(--brown);background:#fffaea;border:2px solid var(--ink);border-radius:5px;padding:4px 6px}
.se-stock{display:flex;gap:6px;align-items:center}
.se-inf{display:inline-flex;gap:3px;align-items:center;font-weight:800;cursor:pointer}
@media (max-width:560px){.se-head{display:none}.se-item{grid-template-columns:30px 1fr 32px;}.se-item input[data-f=price]{grid-column:2}.se-stock{grid-column:2}}


/* ═══ v19 : images des techniques ════════════════════ */
.tf-media{display:grid;grid-template-columns:160px 1fr;gap:14px;align-items:start}
.tf-preview{width:160px;height:110px;border:3px solid var(--ink);border-radius:6px;background:#fbf0d2;display:grid;place-items:center;overflow:hidden;text-align:center;padding:4px;font-size:12px}
.tf-preview img{width:100%;height:100%;object-fit:cover;display:block}
.tf-ctl{display:grid;gap:8px}
.tech summary{grid-template-columns:auto 1fr auto}
.tech summary > span:first-child:not(.t-thumb){grid-column:1/3}
.t-thumb{width:44px;height:44px;border:2px solid var(--ink);border-radius:5px;overflow:hidden;background:#fbf0d2}
.t-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.t-media{margin:0 16px 10px;border:3px solid var(--ink);border-radius:8px;overflow:hidden;background:#17255e;box-shadow:3px 3px 0 rgba(23,37,94,.3);max-width:520px}
.t-media img{display:block;width:100%;max-height:300px;object-fit:contain}
.t-media.broken{display:none}
@media (max-width:560px){.tf-media{grid-template-columns:1fr}.tf-preview{width:100%;height:150px}}

@media (max-width:860px){
  .deck{grid-template-columns:1fr}
  .left{max-width:420px;margin:0 auto;width:100%}
}
