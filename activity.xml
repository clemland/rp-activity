/* ═══ v20 : version connectée ════════════════════════ */
.boot{position:fixed;inset:0;z-index:200;display:grid;place-content:center;justify-items:center;gap:10px;background:rgba(9,20,52,.55);backdrop-filter:blur(2px);color:#fff3cf;font-weight:800;text-align:center;padding:20px}
.boot img{width:min(420px,80vw)}
.boot.error p{background:var(--paper);color:var(--brown);border:3px solid var(--ink);border-radius:8px;padding:12px 16px;max-width:460px;font-weight:700}
.boot[hidden]{display:none!important}
body.busy{cursor:progress}
.mj-banner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:var(--ink);color:#fff3cf;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-weight:700;box-shadow:4px 4px 0 var(--shadow)}
.mj-banner .btn{box-shadow:2px 2px 0 rgba(0,0,0,.4)}
.readonly #s-fiche .sq,.readonly #s-fiche [data-equip],.readonly #s-fiche [data-drop],.readonly #s-fiche #job-do,.readonly #s-fiche #job-up,.readonly #s-fiche #new-tech,.readonly #s-fiche [data-edit-tech],.readonly #s-fiche [data-del-tech],.readonly #s-fiche [data-craft],.readonly #s-fiche #craft-collect,.readonly #s-fiche #craft-cancel{display:none!important}
.mj-players{display:grid;gap:6px;max-height:50vh;overflow:auto;margin-top:10px}
.mj-player{display:grid;grid-template-columns:44px 1fr auto;gap:10px;align-items:center;text-align:left;border:2px solid var(--ink);border-radius:8px;background:#fbf0d2;padding:6px 10px;cursor:pointer;font:inherit;color:inherit}
.mj-player:hover{background:#fff6dc}
.mj-player .av{width:40px;height:46px;border:2px solid var(--ink);border-radius:4px;overflow:hidden;background:#9fd3ef}
.mj-player .av img,.mj-player .av svg{width:100%;height:100%;object-fit:cover;display:block}
.mj-player small{color:var(--muted);display:block}
.mj-search{width:100%;font:inherit;font-size:16px;color:var(--brown);background:#fffaea;border:3px solid var(--ink);border-radius:5px;padding:7px 10px}
.no-shop{text-align:center;padding:30px 10px;display:grid;gap:10px;justify-items:center}
.no-shop h2{font-family:"Ultra",Georgia,serif;font-weight:400;margin:0}
.discord-hint{margin-top:12px;background:#fff7e0;border:2px dashed var(--ink);border-radius:8px;padding:10px 14px;font-weight:600}

/* ═══ v21 : onglet Édition MJ ════════════════════════ */
.tab-mj{color:#7a4a12}
.mj-summary{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 4px}
.mj-summary > span{display:flex;flex-direction:column;gap:2px;background:#fbf0d2;border:2px solid var(--ink);border-radius:6px;padding:6px 12px;font-weight:700}
.mj-summary small{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);font-weight:800}
.mj-summary .stars{display:inline-flex}
.mj-summary .stars .ico{--s:18px}
.val-list{display:grid;gap:12px}
.val-card{display:grid;grid-template-columns:minmax(0,220px) 1fr;gap:16px;border:3px solid var(--ink);border-radius:10px;background:#fbf0d2;padding:12px;box-shadow:4px 4px 0 rgba(23,37,94,.25)}
.val-card:not(:has(.val-media)){grid-template-columns:1fr}
.val-media{border:3px solid var(--ink);border-radius:8px;overflow:hidden;background:#17255e;align-self:start}
.val-media img{display:block;width:100%;max-height:200px;object-fit:contain}
.val-body h3{margin:0 0 6px;font-size:19px;display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.val-body p{margin:0 0 10px;max-width:62ch}
.val-acts{display:flex;gap:8px;flex-wrap:wrap}
.mj-tools{display:grid;gap:10px;border:3px solid var(--ink);border-radius:8px;padding:12px 14px;background:#fbf0d2}
.linklike{background:none;border:none;padding:0;font:inherit;font-weight:800;color:var(--sea);text-decoration:underline;cursor:pointer}
