    const c = fleet.crews?.[o.id];
    return `${c?.kind === 'flotte' ? 'Flotte' : 'Équipage'} : ${c?.name ?? '?'}`;
  }
  return `Joueur : ${G.fullName({ id: players.find((p) => p.uid === o.id)?.ident || {} })}`;
};
