/* ═══ v22 : atelier, gestion, sans fiche ═════════════ */
.ico.item-img{background:none;display:inline-grid;place-items:center;overflow:hidden}
.ico.item-img img{width:100%;height:100%;object-fit:contain;display:block}
.no-fiche{min-height:280px;display:grid;place-items:center}
.no-fiche .ico,.no-shop .ico{--s:56px}
.craft-now{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;margin-top:16px;border:3px solid var(--ink);border-radius:10px;padding:12px 14px;background:#fff7e0;box-shadow:4px 4px 0 rgba(23,37,94,.25)}
.craft-now.ready{background:#e9f7ea;border-color:#1d7a3a}
